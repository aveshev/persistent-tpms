<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup and device transfer from API 31, see backup_rules.xml up to API 30. car.db is
   replaced by the slim copy SlimBackupAgent builds next to it (car-backup.db, see DatabaseBackup):
   Auto Backup stops backing up an app whose data passes 25 MB, which the readings would reach.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="car.db" />
        <exclude domain="database" path="car.db-wal" />
        <exclude domain="database" path="car.db-shm" />
        <exclude domain="database" path="car.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="car.db" />
        <exclude domain="database" path="car.db-wal" />
        <exclude domain="database" path="car.db-shm" />
        <exclude domain="database" path="car.db-journal" />
    </device-transfer>
</data-extraction-rules>
