<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup up to API 30, see data_extraction_rules.xml from API 31. car.db is replaced by the
   slim copy SlimBackupAgent builds next to it (car-backup.db, see DatabaseBackup): Auto Backup
   stops backing up an app whose data passes 25 MB, which the readings would reach.
-->
<full-backup-content>
    <exclude domain="database" path="car.db" />
    <exclude domain="database" path="car.db-wal" />
    <exclude domain="database" path="car.db-shm" />
    <exclude domain="database" path="car.db-journal" />
</full-backup-content>
