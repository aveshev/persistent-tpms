<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- data:vehicle (BLE scan) caps these at maxSdkVersion 28 (coarse) and 30 (fine), but
         feature:background needs both on every API level (see its manifest) to read the connected
         WiFi SSID; the unconditional declarations cover both needs, so they're made explicit here
         to resolve the manifest merge conflict. -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="replace" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="replace" />

    <!-- Guards AppLinkProvider: only the other version of the app (Lite or Pro), signed with the
         same key, holds it. Both declare it, so it's granted whichever is installed first. -->
    <permission
        android:name="${appLinkPermission}"
        android:protectionLevel="signature" />
    <uses-permission android:name="${appLinkPermission}" />

    <queries>
        <package android:name="${otherApplicationId}" />
    </queries>

    <application
        android:allowBackup="true"
        android:backupAgent=".interfaces.SlimBackupAgent"
        android:fullBackupOnly="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TPMSAdvanced"
        tools:targetApi="31">
        <activity
            android:name=".interfaces.RootActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="vehicle"
                    android:scheme="tpmsadvanced" />

            </intent-filter>
        </activity>
        <!-- Read by OtherApp: the other version's app ID, and the permission guarding both providers -->
        <meta-data
            android:name="com.masselis.tpmsadvanced.OTHER_APPLICATION_ID"
            android:value="${otherApplicationId}" />
        <meta-data
            android:name="com.masselis.tpmsadvanced.APP_LINK_PERMISSION"
            android:value="${appLinkPermission}" />
        <!-- See OtherApp, call() checks the permission on its own -->
        <provider
            android:name="com.masselis.tpmsadvanced.feature.background.interfaces.AppLinkProvider"
            android:authorities="${applicationId}.app-link"
            android:exported="true"
            android:permission="${appLinkPermission}" />
        <service
            android:name="com.masselis.tpmsadvanced.feature.androidauto.endpoint.CarAppService"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            tools:node="merge" />
    </application>

</manifest>